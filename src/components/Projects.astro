---
const projects = [
    {
        title: "Landing Page Para Abogado",
        description:
            "Landing page para estudio jurídico, con presentación de servicios y contacto directo.",
        tech: ["Astro", "Tailwind CSS"],
        link: "https://github.com/Victor7128/portfolio-abogado",
        photo: "./mockup_abogado.webp",
        expandable: true,
    },
        {
        title: "Landing Page Para Fotografo",
        description:
            "Landing page para fotógrafo profesional, con galería de trabajos y sección de contacto.",
        tech: ["Astro", "Tailwind CSS", "Svelte"],
        link: "https://github.com/Victor7128/portfolio-camera",
        photo: "./mockup_camera.webp",
        expandable: true,
    },
    {
        title: "Pomodoro-Timer",
        description:
            "Aplicación de temporizador Pomodoro para mejorar la productividad.",
        tech: ["Rust", "Tauri"],
        link: "https://github.com/Victor7128/pomodoro-timer",
        photo: "/logo2.webp",
    },
    {
        title: "Calculadora",
        description:
            "Aplicación de escritorio de calculadora con funcionalidades básicas.",
        tech: ["Rust", "Tauri"],
        link: "https://github.com/Victor7128/calculadora_tauri",
        photo: "/logo3.webp",
    },
];
---

<section
    id="proyectos"
    class="min-h-screen flex items-center justify-center px-6 py-20"
>
    <div class="max-w-4xl w-full">
        <h2 class="text-5xl md:text-6xl font-bold mb-16">Proyectos</h2>

        <div class="space-y-8">
            {
                projects.map((project, index) => (
                    project.expandable ? (
                        <div class="project-toggle">
                            <button
                                type="button"
                                class="group toggle-btn block w-full text-left cursor-pointer"
                                aria-expanded="false"
                            >
                                <div class="toggle-card relative p-8 md:p-10 bg-gray-50 rounded-3xl hover:bg-white hover:shadow-xl hover:shadow-gray-200/50 transition-all duration-700 ease-out overflow-hidden border border-transparent hover:border-gray-200">
                                    <!-- Imagen de fondo -->
                                    <div
                                        class="absolute inset-0 bg-cover bg-center opacity-5 group-hover:opacity-8 transition-all duration-700 ease-out"
                                        style={`background-image: url('${project.photo}');`}
                                    />

                                    <!-- Contenido -->
                                    <div class="relative z-10">
                                        <div class="flex items-start justify-between gap-6 mb-4">
                                            <div class="flex-1">
                                                <h3 class="text-2xl md:text-3xl font-bold text-gray-900 group-hover:text-gray-950 transition-colors duration-700 ease-out mb-3">
                                                    {project.title}
                                                </h3>
                                                <p class="text-gray-600 group-hover:text-gray-700 transition-colors duration-700 ease-out text-lg">
                                                    {project.description}
                                                </p>
                                            </div>

                                            <!-- Ícono de flecha, rota cuando está abierto -->
                                            <div class="toggle-icon shrink-0 w-10 h-10 rounded-full bg-gray-200 group-hover:bg-gray-900 flex items-center justify-center transition-all duration-500 ease-out">
                                                <svg
                                                    class="w-5 h-5 text-gray-600 group-hover:text-white transition-colors duration-500 ease-out"
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    fill="none"
                                                    viewBox="0 0 24 24"
                                                    stroke="currentColor"
                                                >
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                                </svg>
                                            </div>
                                        </div>

                                        <!-- Tech stack -->
                                        <div class="flex flex-wrap gap-2 mt-6">
                                            {project.tech.map((tech) => (
                                                <span class="px-4 py-1.5 text-sm bg-white text-gray-700 rounded-full border border-gray-200 group-hover:bg-gray-50 group-hover:border-gray-300 group-hover:text-gray-900 transition-all duration-700 ease-out">
                                                    {tech}
                                                </span>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                            </button>

                            <!-- Panel desplegable animado (grid-rows 0fr -> 1fr) -->
                            <div class="toggle-panel grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 ease-out">
                                <div class="overflow-hidden">
                                    <div class="mt-4 px-2 md:px-4 opacity-0 translate-y-2 transition-all duration-500 ease-out toggle-panel-inner">
                                        <div class="rounded-3xl overflow-hidden border border-gray-200 bg-gray-50">
                                            <img
                                                src={project.photo}
                                                alt={`Captura del proyecto ${project.title}`}
                                                class="w-full h-auto object-cover"
                                                loading="lazy"
                                            />
                                        </div>
                                        <a
                                            href={project.link}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="inline-flex items-center gap-2 mt-4 text-sm text-gray-600 hover:text-gray-900 transition-colors duration-300"
                                        >
                                            Ver repositorio en GitHub
                                            <svg
                                                class="w-4 h-4"
                                                xmlns="http://www.w3.org/2000/svg"
                                                fill="none"
                                                viewBox="0 0 24 24"
                                                stroke="currentColor"
                                            >
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                                            </svg>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ) : (
                        <a
                            href={project.link}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="group block"
                        >
                            <div class="relative p-8 md:p-10 bg-gray-50 rounded-3xl hover:bg-white hover:shadow-xl hover:shadow-gray-200/50 transition-all duration-700 ease-out overflow-hidden border border-transparent hover:border-gray-200">
                                <!-- Imagen de fondo -->
                                <div
                                    class="absolute inset-0 bg-cover bg-center opacity-5 group-hover:opacity-8 transition-all duration-700 ease-out"
                                    style={`background-image: url('${project.photo}');`}
                                />

                                <!-- Contenido -->
                                <div class="relative z-10">
                                    <div class="flex items-start justify-between gap-6 mb-4">
                                        <div class="flex-1">
                                            <h3 class="text-2xl md:text-3xl font-bold text-gray-900 group-hover:text-gray-950 transition-colors duration-700 ease-out mb-3">
                                                {project.title}
                                            </h3>
                                            <p class="text-gray-600 group-hover:text-gray-700 transition-colors duration-700 ease-out text-lg">
                                                {project.description}
                                            </p>
                                        </div>

                                        <!-- Ícono de flecha -->
                                        <div class="shrink-0 w-10 h-10 rounded-full bg-gray-200 group-hover:bg-gray-900 group-hover:-rotate-45 flex items-center justify-center transition-all duration-700 ease-out">
                                            <svg
                                                class="w-5 h-5 text-gray-600 group-hover:text-white transition-colors duration-700 ease-out"
                                                xmlns="http://www.w3.org/2000/svg"
                                                fill="none"
                                                viewBox="0 0 24 24"
                                                stroke="currentColor"
                                            >
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                                            </svg>
                                        </div>
                                    </div>

                                    <!-- Tech stack -->
                                    <div class="flex flex-wrap gap-2 mt-6">
                                        {project.tech.map((tech) => (
                                            <span class="px-4 py-1.5 text-sm bg-white text-gray-700 rounded-full border border-gray-200 group-hover:bg-gray-50 group-hover:border-gray-300 group-hover:text-gray-900 transition-all duration-700 ease-out">
                                                {tech}
                                            </span>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        </a>
                    )
                ))
            }
        </div>
    </div>
</section>

<script>
    // Controla la animación de apertura/cierre de las tarjetas de proyecto desplegables.
    function initProjectToggles() {
        const toggles = document.querySelectorAll<HTMLElement>(".project-toggle");

        toggles.forEach((wrapper) => {
            const btn = wrapper.querySelector<HTMLButtonElement>(".toggle-btn");
            const panel = wrapper.querySelector<HTMLElement>(".toggle-panel");
            const panelInner = wrapper.querySelector<HTMLElement>(".toggle-panel-inner");
            const icon = wrapper.querySelector<HTMLElement>(".toggle-icon");

            if (!btn || !panel || !panelInner || !icon) return;
            if (btn.dataset.bound === "true") return; // evita doble binding con Astro view transitions
            btn.dataset.bound = "true";

            btn.addEventListener("click", () => {
                const isOpen = btn.getAttribute("aria-expanded") === "true";
                const nextOpen = !isOpen;

                btn.setAttribute("aria-expanded", String(nextOpen));

                if (nextOpen) {
                    panel.classList.remove("grid-rows-[0fr]");
                    panel.classList.add("grid-rows-[1fr]");
                    panelInner.classList.remove("opacity-0", "translate-y-2");
                    icon.classList.add("rotate-180", "bg-gray-900");
                    icon.querySelector("svg")?.classList.add("text-white");
                } else {
                    panel.classList.remove("grid-rows-[1fr]");
                    panel.classList.add("grid-rows-[0fr]");
                    panelInner.classList.add("opacity-0", "translate-y-2");
                    icon.classList.remove("rotate-180", "bg-gray-900");
                    icon.querySelector("svg")?.classList.remove("text-white");
                }
            });
        });
    }

    initProjectToggles();
    document.addEventListener("astro:page-load", initProjectToggles);
</script>