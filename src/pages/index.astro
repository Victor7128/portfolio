---
import Layout from "../layouts/Layout.astro";
import SocialNav from "../components/SocialNav.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Projects from "../components/Projects.astro";
import Contact from "../components/Contact.astro";
---

<Layout
    title="Portafolio de Victor"
    description="Desarrollador Backend junior especializado en crear experiencias web y aplicaciones modernas y elegantes."
>
    <SocialNav />
    <main>
        <Hero />
        <About />
        <Projects />
        <Contact />
    </main>

    <footer class="py-8 text-center text-gray-600">
        <p>
            &copy; {new Date().getFullYear()} Victor Hugo Tuesta Reyna. Todos los
            derechos reservados.
        </p>
    </footer>
</Layout>

<style>
    html {
        scroll-behavior: smooth;
    }
</style>
